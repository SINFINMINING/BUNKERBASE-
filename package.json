{"name": "bunkerbase", "version": "1.0.0", "description": "Web3 IPO Platform with Social Hub on Base", "private": true, "workspaces": ["packages/*"], "scripts": {"dev": "turbo run dev --parallel", "build": "turbo run build", "test": "turbo run test", "lint": "turbo run lint", "format": "prettier --write \"**/*.{ts,tsx,js,jsx,sol,md}\"", "clean": "turbo run clean && rm -rf node_modules"}, "devDependencies": {"prettier": "^3.0.0", "turbo": "^1.10.0", "typescript": "^5.0.0"}}